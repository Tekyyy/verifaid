# Chain the build is locked to. 84532 = Base Sepolia, 31337 = local anvil.
NEXT_PUBLIC_CHAIN_ID=84532
# Optional RPC override; defaults to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=

# Ponder indexer. The browser reaches it through /api/indexer on this origin.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
# Set to 1 to render the bundled sample data instead of calling the indexer.
NEXT_PUBLIC_USE_FIXTURES=

# Off-chain services (spec §9)
NEXT_PUBLIC_EVIDENCE_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_PII_VAULT_URL=http://localhost:4002

# Reached only through this app's route handlers (/api/checkout, /api/alerts), never from the browser.
BANK_CONNECTOR_URL=http://localhost:4003
NOTIFIER_URL=http://localhost:4004

# Optional ERC-7677 paymaster (e.g. a Coinbase Developer Platform endpoint). When set and the connected wallet
# reports the paymasterService capability (Coinbase Smart Wallet), writes are gas-sponsored.
NEXT_PUBLIC_PAYMASTER_URL=

# Server-only. The app's relayer: pays the gas for beneficiary confirmations (so their address never appears on
# chain) and, on v3 deployments, for deposit-address deploys, "Sweep now", refunds signed with a donor's refund key
# and sandbox on-ramp mints of test USDC. All of them share one nonce queue. Keep it funded with a little ETH; on
# deployments where sweeping is restricted, register its address as a keeper on the DonationForwarderFactory.
# Never prefix this with NEXT_PUBLIC_.
RELAYER_PRIVATE_KEY=

# "Pay by card" (v3). coinbase = Coinbase Onramp buys USDC into the donor's own wallet (mainnet networks only);
# mock = a sandbox that mints test USDC via the relayer. Unset: coinbase on Base mainnet (8453), mock elsewhere.
# Base mainnet never runs the mock, whatever this says.
NEXT_PUBLIC_ONRAMP_MODE=
# Coinbase Developer Platform secret API key for the Onramp (server-only; coinbase mode). The secret is either the
# base64 Ed25519 key or a legacy EC PEM (newlines may be written as \n). Add this site's domain to the project's
# Onramp domain allowlist in the CDP portal so the post-purchase redirect works.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional, informational: the CDP project the key belongs to.
# NEXT_PUBLIC_CDP_PROJECT_ID=
