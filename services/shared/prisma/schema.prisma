// Data layer for the Proof of Aid off-chain services.
//
// One schema, one database, four services (evidence, pii-vault, bank-connector, notifier). Nothing here is ever written
// to the chain: personal data lives only in `ciphertext` columns whose data keys are wrapped by a KEK derived
// per NGO. Deleting `wrappedDek` (crypto-shredding) makes a record permanently unreadable, which is how the
// right to erasure is honoured without removing rows that on-chain hashes refer to.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An enrolled beneficiary. The only field that ever reaches the chain is `commitment`,
/// an unlinkable Semaphore identity commitment.
model Beneficiary {
  id          String    @id @default(uuid())
  ngoAddress  String
  programId   String
  /// Semaphore identity commitment, decimal string.
  commitment  String
  /// iv ‖ authTag ‖ AES-256-GCM ciphertext of the personal record.
  ciphertext  Bytes
  /// DEK sealed with the NGO's key-encryption key. NULL once the record has been crypto-shredded.
  wrappedDek  Bytes?
  createdAt   DateTime  @default(now())
  /// When the data key was destroyed (right to erasure).
  shreddedAt  DateTime?

  @@unique([programId, commitment])
  @@index([ngoAddress, programId])
}

/// Encrypted needs assessment. `hash` is keccak256 of the ciphertext and is what the need carries on-chain.
model Dossier {
  hash       String   @id
  ngoAddress String
  needId     String?
  ciphertext Bytes
  wrappedDek Bytes?
  createdAt  DateTime @default(now())

  @@index([ngoAddress])
}

/// Encrypted delivery evidence. The ciphertext itself lives on IPFS; only its key and metadata are stored here.
model Evidence {
  cid           String   @id
  /// keccak256 of the ciphertext — the value anchored in the DeliveryEvidence attestation.
  evidenceHash  String   @unique
  deliveryId    String
  ngoAddress    String
  uploader      String
  wrappedDek    Bytes?
  /// Non-personal manifest: item counts, coarse region, file names and sizes.
  manifest      Json
  attestationUID String?
  createdAt     DateTime @default(now())

  grants KeyGrant[]

  @@index([deliveryId])
  @@index([ngoAddress])
}

/// Per-grantee wrapped key: how an NGO shares one evidence bundle with one verifier.
model KeyGrant {
  id             String   @id @default(uuid())
  evidenceCid    String
  granteeAddress String
  /// The evidence DEK, re-wrapped for this grantee.
  wrappedKey     Bytes
  grantedBy      String
  createdAt      DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceCid], references: [cid], onDelete: Cascade)

  @@unique([evidenceCid, granteeAddress])
  @@index([granteeAddress])
}

/// A fiat donation the payment provider received: converted and deposited on-chain for on-chain custody, or held
/// and attested for off-chain custody. Idempotency key: the ISO 20022 end-to-end reference (or checkout id).
model FiatTransfer {
  endToEndId     String   @id
  needId         String
  /// The need's ledger: an AidVault (OnChain) or a NonCustodialLedger (OffChain).
  vault          String
  amountBaseUnits String
  amountEurCents  Int
  /// Intermediary fee kept by the provider, in token base units (gross = amount + fee).
  feeBaseUnits   String   @default("0")
  /// ISO 4217 currency the donor paid in.
  currency       String   @default("EUR")
  /// SEPA (bank webhook) | CARD / BANK (checkout) | CSV (bulk import).
  source         String   @default("SEPA")
  /// OnChain | OffChain, copied from the need when the transfer was received.
  custodyMode    String   @default("OnChain")
  /// keccak256(abi.encode(partnerSalt, endToEndId)) — the raw reference never leaves this service.
  paymentRefHash String   @unique
  /// keccak256(abi.encode(partnerSalt, donorReference)).
  donorRefHash   String
  status         String   @default("RECEIVED")
  donateTxHash   String?
  attestTxHash   String?
  attestationUID String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([needId])
}

/// A payout the provider made for an off-chain need's tranche, reported on-chain as a Settlement attestation.
model ProviderSettlement {
  id               String   @id @default(uuid())
  needId           String
  trancheIndex     Int
  grossBaseUnits   String
  feeBaseUnits     String
  /// keccak256(abi.encode(partnerSalt, supplierReference)).
  supplierRefHash  String
  fxRef            String
  status           String   @default("RECEIVED")
  attestTxHash     String?
  attestationUID   String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([needId, trancheIndex])
}

/// A donation alert subscription keyed by a tracking reference (or a whole need). There is no account: the
/// subscriber holds an unsubscribe token, stored only as a hash. An email address is envelope-encrypted and its
/// data key destroyed on unsubscribe, so the address is unrecoverable afterwards (crypto-shredding).
model AlertSubscription {
  id              String    @id @default(uuid())
  trackingRef     String?
  needId          String
  /// EMAIL | WEBHOOK
  channel         String
  emailCiphertext Bytes?
  wrappedDek      Bytes?
  webhookUrl      String?
  /// sha256 of the unsubscribe token.
  tokenHash       String
  /// Donor stages (and outcomes) already notified, so each is sent once.
  notifiedStages  String[]
  createdAt       DateTime  @default(now())
  unsubscribedAt  DateTime?

  @@index([needId])
  @@index([trackingRef])
}

/// An integrator's outbound webhook: HMAC-signed POSTs for timeline events (integration levels 2-3).
model WebhookEndpoint {
  id           String   @id @default(uuid())
  url          String
  /// Only events of this need; null for every need.
  needId       String?
  /// Timeline event types to deliver; empty for all.
  eventTypes   String[]
  /// Signing secret, sealed with the service key.
  sealedSecret Bytes
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  deliveries NotificationDelivery[]
}

/// One outbound notification and its delivery attempts (alert email, alert webhook or integrator webhook).
model NotificationDelivery {
  id             String   @id @default(uuid())
  /// "<kind>:<subscription or endpoint id>:<event id or stage>" — makes every notification exactly-once.
  dedupeKey      String   @unique
  /// ALERT_EMAIL | ALERT_WEBHOOK | WEBHOOK
  kind           String
  subscriptionId String?
  endpointId     String?
  /// PENDING | SENT | FAILED
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  /// The rendered message or event body. Never contains an email address.
  payload        Json
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  endpoint WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

/// Where the notifier's timeline poller left off.
model NotifierCursor {
  id          String   @id
  blockNumber BigInt
  logIndex    Int
  updatedAt   DateTime @updatedAt
}

/// Single-use SIWE nonces.
model AuthNonce {
  value     String   @id
  address   String?
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}
