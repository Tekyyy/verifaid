    "fastify": "5.12.4",
    "fastify-type-provider-zod": "7.0.0",
    "viem": "2.56.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
