# ─── Chain ────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# Deployer / platform admin. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=
# Etherscan V2 (Basescan) key used by `forge script --verify`
BASESCAN_API_KEY=

# Local development chain (anvil)
ANVIL_RPC_URL=http://127.0.0.1:8545

# ─── External contracts (verified 2026-09-16, see docs/DECISIONS.md §3.2) ──────
# EAS + SchemaRegistry are OP Stack predeploys on Base Sepolia (both report version 1.2.0).
EAS_ADDRESS=0x4200000000000000000000000000000000000021
SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
# Semaphore v4, from the official @semaphore-protocol/utils deployment list. Empty => deploy a local instance.
SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D
# Empty => deploy MockEURC (mintable test token). Circle USDC on Base Sepolia is
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e if you prefer a faucet-funded token.
STABLECOIN_ADDRESS=

# ─── Protocol parameters ──────────────────────────────────────────────────────
# Share of the raised amount whose donors must approve a delivery before the next tranche unlocks (3000 = 30%).
DONOR_APPROVAL_BPS=3000
HIGH_VALUE_THRESHOLD=10000000000
# Smallest "people served" an impact report may state (a k-anonymity floor).
MIN_BENEFICIARIES_SERVED=5
DASHBOARD_BASE_URI=http://localhost:3000/needs/

# ─── Services ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://poa:poa@localhost:5432/poa
# Host port for the Compose Postgres. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=poa
# Which deployment the services read (anvil | base-sepolia) and which RPC they use.
POA_NETWORK=anvil
SERVICES_RPC_URL=http://127.0.0.1:8545
LOG_LEVEL=info
PII_VAULT_PORT=4002
# SIWE domain each service accepts sign-ins for; must match the host the browser used.
PII_VAULT_SIWE_DOMAIN=localhost:4002
# 32-byte hex key that wraps per-record data keys. Generate: openssl rand -hex 32
NGO_KEK_PATH=./secrets/ngo-kek.key
PII_VAULT_URL=http://localhost:4002
# Shared secret for SIWE session tokens issued by the services
SESSION_SECRET=

# ─── Indexer ──────────────────────────────────────────────────────────────────
PONDER_NETWORK=anvil
PONDER_RPC_URL=http://127.0.0.1:8545
PONDER_DATABASE_URL=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_PAYMASTER_URL=
NEXT_PUBLIC_PII_VAULT_URL=http://localhost:4002
# Relayer that submits beneficiary confirmations, so a beneficiary's own address never appears on-chain
RELAYER_PRIVATE_KEY=

# ─── Demo ─────────────────────────────────────────────────────────────────────
# Mnemonic that derives the demo role wallets (admin, ngo, verifiers, suppliers, donors, relayer).
# The anvil default mnemonic is used when this is empty.
DEMO_MNEMONIC=
# Deterministic seed for the demo beneficiary identities. PUBLIC by design — demo only.
DEMO_IDENTITY_SEED=proof-of-aid-demo

# ─── Notifier (donation alerts + integrator webhooks) ─────────────────────────
NOTIFIER_PORT=4004
NOTIFIER_URL=http://localhost:4004
# Indexer the worker tails: INDEXER_URL when run with pnpm, NOTIFIER_INDEXER_URL inside compose
# (default http://host.docker.internal:42069)
INDEXER_URL=http://localhost:42069
NOTIFIER_INDEXER_URL=
# Dashboard base URL, for tracking links in alerts (<APP_BASE_URL>/en/track/<ref>)
APP_BASE_URL=http://localhost:3000
# Where subscribers' mail clients reach the notifier, for unsubscribe links in emails
PUBLIC_BASE_URL=http://localhost:4004
# 32-byte hex key that encrypts stored email addresses. Empty => key file at NOTIFIER_KEK_PATH, created on first run.
NOTIFIER_KEK=
NOTIFIER_KEK_PATH=./secrets/notifier-kek.key
# Bearer token for the webhook admin API and /outbox (min. 16 chars). Empty => admin API disabled (503).
NOTIFIER_ADMIN_TOKEN=
# on | off: the timeline poller + delivery dispatcher running inside the service process
NOTIFIER_WORKER=on
NOTIFIER_POLL_MS=10000
NOTIFIER_WEBHOOK_TIMEOUT_MS=10000
# Resend-compatible email API (POST { from, to, subject, text }). Empty => "outbox" driver, see GET /outbox.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=Proof of Aid <alerts@proof-of-aid.local>
