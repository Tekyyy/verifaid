{
  "name": "proof-of-aid",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Aid: verified needs, traceable donations, anonymous delivery confirmations and verifiable impact on Base.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "//test": "Serial on purpose: the service suites drive the same chain with the same role wallets, so running them in parallel collides on nonces.",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "contracts:build": "pnpm --filter @poa/contracts build",
    "contracts:test": "pnpm --filter @poa/contracts test",
    "chain": "anvil --chain-id 31337 --block-time 1",
    "deploy:local": "node scripts/deploy-local.mjs",
    "deploy:sepolia": "node scripts/deploy-sepolia.mjs",
    "demo:run": "pnpm --filter @poa/demo start",
    "demo:identities": "pnpm --filter @poa/demo identities",
    "indexer:dev": "pnpm --filter @poa/indexer dev",
    "app:dev": "pnpm --filter @poa/app dev",
    "notifier:dev": "pnpm --filter @poa/notifier dev",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f evidence pii-vault bank-connector notifier",
    "db:push": "pnpm --filter @poa/shared exec prisma db push",
    "verify": "node scripts/verify-all.mjs",
    "abis": "node scripts/export-abis.mjs",
    "sync:deployments": "node scripts/sync-deployments.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "5.9.3"
  }
}
