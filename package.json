{
  "name": "proof-of-aid",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Aid: verified needs, traceable donations, anonymous delivery confirmations and verifiable impact on Base.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contracts:build": "pnpm --filter @poa/contracts build",
    "contracts:test": "pnpm --filter @poa/contracts test",
    "chain": "anvil --chain-id 31337 --block-time 1",
    "deploy:local": "node scripts/deploy-local.mjs",
    "abis": "node scripts/export-abis.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "5.9.3"
  }
}
