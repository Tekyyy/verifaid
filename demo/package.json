{
  "name": "@poa/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the whole Proof of Aid lifecycle against a live chain and prints explorer links",
  "scripts": {
    "start": "tsx src/run.ts",
    "identities": "tsx src/identities.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@poa/shared": "workspace:*",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "dotenv": "17.4.2",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
